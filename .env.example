# ── Anthropic ──────────────────────────────────────────────────────────────────
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase ───────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
# Server-side only — never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── CORS ───────────────────────────────────────────────────────────────────────
# In production set this to your exact origin (e.g. https://apexapply.app).
# Leave unset in development — the API will allow any localhost origin.
ALLOWED_ORIGIN=https://apexapply.app
